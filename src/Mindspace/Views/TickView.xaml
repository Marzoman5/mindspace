<UserControl x:Class="Mindspace.Views.TickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="18,2,18,14">
        <Border Style="{StaticResource Card}" Padding="14,10,8,10">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="AddBtn" DockPanel.Dock="Right" Width="32" Height="32" Click="Add_Click" Cursor="Hand" Content="&#xE710;" ToolTip="Add (Enter)" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="e" Fill="{TemplateBinding Background}"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#0B2A2A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Opacity" Value="0.85"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="Ask" Style="{StaticResource Input}" Tag="Remind me to…  e.g. call mom tomorrow at 5" VerticalAlignment="Center" PreviewKeyDown="Ask_KeyDown" TextChanged="Ask_Changed" Margin="0,0,8,0" TextWrapping="NoWrap"/>
                </DockPanel>
                <!-- live understanding of what you typed: instant, no model involved -->
                <StackPanel x:Name="Preview" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="11" Foreground="#38F9D7" Margin="1,1,6,0"/>
                    <TextBlock x:Name="PreviewText" FontSize="12" Foreground="#38F9D7"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="EmptyText" Text="Nothing on your plate. Tell me what to remember." Foreground="{StaticResource Faint}" Margin="4,14,0,6" FontSize="12.5"/>
        <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" Margin="0,8,-8,0" Padding="0,0,8,0">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
        <DockPanel x:Name="DoneBar" Margin="4,6,0,0" Visibility="Collapsed">
            <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="Clear done" FontSize="11" Padding="9,3,9,4" Margin="0" Click="Clear_Click"/>
            <TextBlock x:Name="DoneText" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</UserControl>
