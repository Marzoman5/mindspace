<UserControl x:Class="Mindspace.Views.SageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="18,2,18,14">
        <ScrollViewer x:Name="Scroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" Margin="0,0,-8,0" Visibility="Collapsed">
            <StackPanel x:Name="Thread" Margin="0,2,0,6"/>
        </ScrollViewer>

        <StackPanel x:Name="Empty" Margin="2,4,0,6">
            <TextBlock Text="What's on your mind?" FontFamily="{StaticResource Ui}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Ask anything. I'll keep it short and clear." Foreground="{StaticResource Muted}" Margin="0,2,0,10"/>
        </StackPanel>

        <WrapPanel x:Name="Chips" Margin="0,0,0,2"/>

        <Border Style="{StaticResource Card}" Padding="14,10,8,10">
            <DockPanel>
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="32" Height="32" VerticalAlignment="Bottom" Click="Send_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="e" Fill="{TemplateBinding Background}"/>
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Opacity" Value="0.85"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="NewBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Clear conversation" Click="New_Click" VerticalAlignment="Bottom" Margin="0,0,4,2" Visibility="Collapsed"/>
                <TextBox x:Name="Ask" Style="{StaticResource Input}" Tag="Explain…" MaxHeight="96" VerticalAlignment="Center" PreviewKeyDown="Ask_KeyDown" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
