<UserControl x:Class="Mindspace.Views.PatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mindspace.Controls">
    <StackPanel Margin="18,2,18,14">
        <UniformGrid x:Name="Gauges" Columns="4" Margin="0,2,0,0"/>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10,14,6">
            <StackPanel>
                <DockPanel Margin="0,0,0,7">
                    <TextBlock x:Name="Facts" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Faint}"/>
                    <TextBlock Text="Busiest right now" Style="{StaticResource Label}"/>
                </DockPanel>
                <StackPanel x:Name="Procs" MinHeight="96"/>
            </StackPanel>
        </Border>

        <Border x:Name="VerdictCard" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed" Background="#12FFA751" BorderBrush="#40FFA751">
            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <c:Markdown x:Name="Verdict"/>
            </ScrollViewer>
        </Border>

        <WrapPanel Margin="0,12,0,-6">
            <Button x:Name="DiagBtn" Style="{StaticResource Primary}" Click="Diagnose_Click" Margin="0,0,6,6" Foreground="#3A1C00">
                <TextBlock x:Name="DiagLabel" Text="What's going on?" Foreground="#3A1C00" FontWeight="SemiBold" FontSize="12.5"/>
            </Button>
            <Button Style="{StaticResource Chip}" Content="Task Manager" Click="TaskMgr_Click" ToolTip="Opens Windows Task Manager"/>
            <Button Style="{StaticResource Chip}" Content="Storage" Click="Storage_Click" ToolTip="Opens Windows storage settings"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
