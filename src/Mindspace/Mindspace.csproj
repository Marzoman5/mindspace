<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Mindspace</AssemblyName>
    <RootNamespace>Mindspace</RootNamespace>
    <Version>0.2.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Zero third-party packages on purpose: nothing to audit but this repo and the .NET runtime. -->
  </PropertyGroup>

</Project>
